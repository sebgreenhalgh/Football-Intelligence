{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football_intelligence.g7f_c.calibration_superseding_annotation.v1",
  "title": "G7F-C calibration superseding annotation event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_sha256",
    "anonymous_dense_image_id",
    "pass_kind",
    "selection_status",
    "source_frame_sha256",
    "source_width",
    "source_height",
    "all_frame_instance_lineage",
    "binding_hashes",
    "reviewer_release",
    "final_revision",
    "adjudication_sequence",
    "adjudication_reason",
    "supersedes_event_id",
    "supersedes_event_sha256",
    "parent_provenance",
    "audit_checklist_sha256",
    "annotation",
    "adjudication_metadata",
    "server_validation",
    "immutable",
    "production_ready"
  ],
  "properties": {
    "schema_version": {"const": "football_intelligence.g7f_c.calibration_superseding_annotation.v1"},
    "event_id": {"type": "string", "pattern": "^calibration-adjudication-[0-9a-f]{24}$"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anonymous_dense_image_id": {"enum": ["DG-001", "DG-002", "DG-003", "DG-004", "DG-005", "DG-006"]},
    "pass_kind": {"const": "CALIBRATION_ADJUDICATION"},
    "selection_status": {"const": "CALIBRATION_ONLY"},
    "source_frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_width": {"type": "integer", "minimum": 1},
    "source_height": {"type": "integer", "minimum": 1},
    "all_frame_instance_lineage": {"type": "array"},
    "binding_hashes": {"type": "object"},
    "reviewer_release": {"type": "string", "minLength": 1},
    "final_revision": {"type": "integer", "minimum": 1},
    "adjudication_sequence": {"type": "integer", "minimum": 1},
    "adjudication_reason": {"const": "CALIBRATION_VISUAL_QA_MATERIAL_OMISSION_REPAIR"},
    "supersedes_event_id": {"type": "string", "minLength": 1},
    "supersedes_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_provenance": {"type": "object"},
    "audit_checklist_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotation": {"type": "object"},
    "adjudication_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudication_assertion", "repair_checklist_addressed"],
      "properties": {
        "adjudication_assertion": {
          "const": "I re-reviewed the full image, addressed the calibration audit findings, and annotated every individually evaluable visible human."
        },
        "repair_checklist_addressed": {"const": true}
      }
    },
    "server_validation": {"type": "object"},
    "immutable": {"const": true},
    "production_ready": {"const": false}
  }
}
