{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "football_intelligence.gold.tracklet_sequence.v1",
  "type": "object",
  "required": ["schema_version", "layer", "gold_sequence_id", "ordered_gold_frame_ids", "annotation", "completion_assertion", "selection_sha256", "source_video_sha256", "reviewer_sha256", "schema_sha256", "event_id", "event_sha256", "immutable", "production_ready"],
  "properties": {
    "schema_version": {"const": "football_intelligence.gold.tracklet_sequence.v1"},
    "layer": {"const": "TRACKLET"},
    "annotation": {
      "type": "object",
      "required": ["confirmed_tracklets", "uncertain_continuity_relations", "primary_evaluation_excludes_uncertain_continuity", "player_identity_implemented"],
      "properties": {
        "confirmed_tracklets": {"type": "array", "items": {"type": "object", "required": ["tracklet_id", "members"]}},
        "uncertain_continuity_relations": {"type": "array", "items": {"type": "object", "required": ["from_tracklet_id", "to_tracklet_id", "relation"], "properties": {"relation": {"const": "POSSIBLY_SAME_PERSON"}}}},
        "primary_evaluation_excludes_uncertain_continuity": {"const": true},
        "player_identity_implemented": {"const": false}
      }
    },
    "immutable": {"const": true},
    "production_ready": {"const": false}
  }
}
